generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

/// Product is the sellable catalog item. Stock is tracked per warehouse through Inventory.
model Product {
  id           String        @id @default(cuid())
  sku          String        @unique
  name         String
  description  String?
  priceInCents Int
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  inventory    Inventory[]
  reservations Reservation[]

  @@index([isActive])
  @@index([name])
}

/// Warehouse is a physical or logical stock location that owns inventory rows.
model Warehouse {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  city         String
  country      String        @default("US")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  inventory    Inventory[]
  reservations Reservation[]

  @@index([isActive])
  @@index([city])
}

/// Inventory stores stock counters for one product in one warehouse.
/// availableStock is derived in application logic as totalStock - reservedStock.
model Inventory {
  id            String        @id @default(cuid())
  productId     String
  warehouseId   String
  totalStock    Int           @default(0)
  reservedStock Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  reservations  Reservation[]

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@index([productId])
  @@index([productId, warehouseId, totalStock, reservedStock])
}

/// Reservation holds stock for a product at a specific warehouse and inventory row.
/// Confirming, cancelling, or expiring a reservation should update Inventory.reservedStock atomically.
model Reservation {
  id             String            @id @default(cuid())
  productId      String
  warehouseId    String
  inventoryId    String
  idempotencyKey String?           @unique
  quantity       Int
  status         ReservationStatus @default(PENDING)
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  inventory      Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([expiresAt])
  @@index([productId, warehouseId])
  @@index([inventoryId, status])
}

/// IdempotencyKey records client request keys so retries return the same outcome instead of duplicating reservations.
model IdempotencyKey {
  id             String   @id @default(cuid())
  key            String   @unique
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime

  @@index([expiresAt])
}
